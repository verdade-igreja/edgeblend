<?xml version='1.0' encoding='utf-8'?>
<!-- edgeblend virtual canvas - written by tools/virtual-display/setup.ps1 -->
<!-- 5760x1080 is an example canvas; use the size your content needs. Set friendlyname to your GPU's DXGI description if the driver picks the wrong adapter. -->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <g_refresh_rate>60</g_refresh_rate>
        <g_refresh_rate>30</g_refresh_rate>
    </global>
    <resolutions>
        <resolution>
            <width>5760</width>
            <height>1080</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
        <resolution>
            <width>5760</width>
            <height>1080</height>
            <refresh_rate>30</refresh_rate>
        </resolution>
    </resolutions>
    <logging>
        <SendLogsThroughPipe>true</SendLogsThroughPipe>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </logging>
    <colour>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <ColourFormat>RGB</ColourFormat>
    </colour>
    <cursor>
        <HardwareCursor>true</HardwareCursor>
        <CursorMaxX>128</CursorMaxX>
        <CursorMaxY>128</CursorMaxY>
        <AlphaCursorSupport>true</AlphaCursorSupport>
        <XorCursorSupportLevel>2</XorCursorSupportLevel>
    </cursor>
    <edid>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
    </edid>
    <edid_integration>
        <enabled>false</enabled>
        <auto_configure_from_edid>false</auto_configure_from_edid>
        <edid_profile_path>EDID/monitor_profile.xml</edid_profile_path>
        <override_manual_settings>false</override_manual_settings>
        <fallback_on_error>true</fallback_on_error>
    </edid_integration>
    <auto_resolutions>
        <enabled>false</enabled>
        <source_priority>manual</source_priority>
        <preferred_mode>
            <use_edid_preferred>false</use_edid_preferred>
            <fallback_width>5760</fallback_width>
            <fallback_height>1080</fallback_height>
            <fallback_refresh>60</fallback_refresh>
        </preferred_mode>
    </auto_resolutions>
</vdd_settings>